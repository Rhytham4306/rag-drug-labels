# Which LLM backend to use for generation: groq | ollama | openai
LLM_PROVIDER=groq

# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (fully local — https://ollama.com, run `ollama pull llama3.1:8b` first)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (paid — only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding model (runs locally via sentence-transformers, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120
